              { "title": "加载态 / 禁用态", "specimens": [{ "label": "加载中…", "loading": true }, { "label": "永久禁用", "disabled": true }, { "label": "暂不可用", "type": "secondary", "disabled": true }], "code": "<DuButton loading>加载中…</DuButton>\n<DuButton disabled>永久禁用</DuButton>\n<DuButton type=\"secondary\" disabled>暂不可用</DuButton>" },
