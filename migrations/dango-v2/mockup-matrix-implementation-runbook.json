  ],
  "outputs": [
    "migrations/dango-v2/mockup-state-matrix-implementation.json",
    "migrations/dango-v2/captures/mockup-matrix-implementation/*.png"
  ],
  "protectedQaArtifact": {
    "path": "migrations/dango-v2/mockup-state-matrix.json",
