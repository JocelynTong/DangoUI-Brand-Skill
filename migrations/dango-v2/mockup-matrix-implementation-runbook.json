{
  "schema": "brand-browser-probe-runbook/v1",
  "brand": "dango-v2",
  "purpose": "Reproduce the implementation-side 24-case mockup matrix without modifying application source or QA-owned artifacts.",
  "prerequisites": [
    "Run from the repository root.",
    "Google Chrome is available at /Applications/Google Chrome.app/Contents/MacOS/Google Chrome, or set CHROME_PATH.",
