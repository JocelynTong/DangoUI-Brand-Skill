{
  "$description": "Evidence-bound DangoUI documentation tokens; navigation and Primary remain separate roles.",
  "$extensions": { "echo.brand.schema": "brand-profile.dtcg/v0.1", "echo.brand.source": "migrations/dango-v2/brand-evidence.json" },
  "color": {
    "surface": {
      "page": { "$type": "color", "$value": "#ffffff", "$extensions": { "echo.brand.target": "--du-bg-2", "echo.brand.channel": "mapped", "echo.brand.status": "identity" } },
      "module": { "$type": "color", "$value": "#ffffff", "$extensions": { "echo.brand.target": "--du-bg-1", "echo.brand.channel": "mapped", "echo.brand.status": "identity" } }
    },
    "text": { "primary": { "$type": "color", "$value": "#000000", "$extensions": { "echo.brand.target": "--du-text-1", "echo.brand.channel": "mapped", "echo.brand.status": "identity" } } },
    "border": { "subtle": { "$type": "color", "$value": "#0000001f", "$extensions": { "echo.brand.target": "--du-border-1", "echo.brand.channel": "mapped", "echo.brand.status": "identity" } } },
    "action": { "primary": { "$type": "color", "$value": "#7C66FF", "$extensions": { "echo.brand.target": "--du-primary-solid-bg", "echo.brand.channel": "mapped", "echo.brand.status": "identity", "echo.brand.evidenceRefs": ["dango-v2-primary-button"] } } },
    "navigation": { "current": { "$type": "color", "$value": "#5854FF", "$extensions": { "echo.brand.target": "--style-docs-navigation-current", "echo.brand.channel": "styleOnly", "echo.brand.status": "styleOnly", "echo.brand.evidenceRefs": ["dango-v2-active-navigation"] } } }
  },
  "dimension": { "control": {
    "normalHeight": { "$type": "dimension", "$value": "32px", "$extensions": { "echo.brand.target": "--style-primary-button-height", "echo.brand.channel": "styleOnly", "echo.brand.status": "styleOnly", "echo.brand.evidenceRefs": ["dango-v2-primary-button"] } },
    "radius": { "$type": "dimension", "$value": "4px", "$extensions": { "echo.brand.target": "--style-primary-button-radius", "echo.brand.channel": "styleOnly", "echo.brand.status": "styleOnly", "echo.brand.evidenceRefs": ["dango-v2-primary-button"] } }
  } }
}
