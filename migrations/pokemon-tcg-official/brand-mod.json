  "layoutRules": {
    "sectionBackgroundChain": {
      "layers": [
        {
          "id": "campaign-stage",
          "assetId": "home-booster-art"
        },
        {
          "id": "database-results",
          "assetId": "database-results-texture"
        }
      ]
    },
    "overlay": {
      "inspectorTag": {
        "mustNotAffectLayout": true
      }
    },
    "bottomBarReserve": {
      "required": true
    },
    "pagePurposeIsolation": {
      "required": true,
      "rule": "Campaign, database and learning treatments may not be promoted into one universal skin."
    },
    "hero": {
      "fullBleed": true,
      "artDirectedCrop": true,
      "maxHostHeight": "Host strategy decision; not a learn-brand token."
    },
    "media": {
      "preserveAspectRatio": true,
      "defaultMode": "widthFix",
      "allowAspectFillOnlyWhen": "computed/source crop evidence exists"
    },
    "paintedBoundaries": {
      "status": "missing",
      "globalize": false
    }
  },
  "platformOverrides": {
    "web": {
      "fontFallback": "Arial, sans-serif",
      "remoteAssetPolicy": "Use inventoried source URLs or local verified copies."
    },
    "miniProgram": {
