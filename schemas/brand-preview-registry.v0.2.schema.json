{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dangoui.dev/schemas/brand-preview-registry.v0.2.schema.json",
  "title": "DangoUI Brand Preview Registry",
  "type": "object",
  "required": ["schema", "updatedAt", "access", "brands"],
  "properties": {
    "schema": { "const": "brand-preview-registry.v0.2" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "access": {
      "type": "object",
      "required": ["read", "authentication", "write"],
      "properties": {
        "read": { "const": "public" },
        "authentication": { "const": "none" },
        "write": { "const": "curated-pull-request" }
      },
      "additionalProperties": false
    },
    "brands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "displayName", "version", "publicationStatus", "sourceUrl", "canonicalSources", "path", "migrationRoot", "artifactFiles", "platformSupport", "reusePolicy", "status", "standardDemo", "businessApply"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "displayName": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
          "publicationStatus": { "enum": ["draft", "public-preview", "published", "retired"] },
          "canonicalSources": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" }, "uniqueItems": true },
          "artifactFiles": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+\\.json$" }, "uniqueItems": true },
          "platformSupport": {
            "type": "object",
            "required": ["web", "taroH5", "weapp", "ios", "android", "flutter", "harmonyos"],
            "additionalProperties": { "enum": ["verified", "planned", "unverified", "unsupported"] }
          },
          "reusePolicy": {
            "type": "object",
            "required": ["metadataAndRules", "runtimeAssets"],
            "properties": {
              "metadataAndRules": { "enum": ["public", "review-required"] },
              "runtimeAssets": { "enum": ["public", "review-required", "excluded"] }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
